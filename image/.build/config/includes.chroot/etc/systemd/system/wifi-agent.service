[Unit]
Description=ChaosOps WiFi agent (127.0.0.1:8080 API + kiosk-shell static server)
Documentation=file:///opt/chaosops/wifi-agent/README.md
Wants=NetworkManager.service
After=NetworkManager.service network.target
# The kiosk session waits for this service to answer on :8080 before Chromium starts.

[Service]
Type=simple
User=chaosops-agent
Group=chaosops-agent
SupplementaryGroups=netdev
# Contract (docs/ARCHITECTURE.md): HTTP API on 127.0.0.1:8080, serves kiosk-shell
# static build at /, CHAOSOPS_DISPLAY_URL surfaced via /api/config.
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=CHAOSOPS_DISPLAY_URL=https://app.chaos-ops.de/register-display
Environment=KIOSK_SHELL_DIR=/opt/chaosops/kiosk-shell
# Per-image overrides (e.g. custom display host) go here, not in the unit:
EnvironmentFile=-/etc/chaosops/wifi-agent.env
WorkingDirectory=/opt/chaosops/wifi-agent
# TODO(workstream C): confirm entrypoint against wifi-agent's documented build
# output once merged; contract-side placeholder is server.js.
ExecStart=/usr/bin/node /opt/chaosops/wifi-agent/server.js
Restart=always
RestartSec=2

# Hardening — the agent only needs: loopback HTTP, D-Bus to NetworkManager
# (nmcli), and its state dir.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StateDirectory=chaosops
ReadWritePaths=/var/lib/chaosops
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
