BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# Kernel — broad x86_64 arch defconfig for maximum hardware/driver coverage
# (this is what makes an unknown mini-PC actually boot), plus our fragment.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.58"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CHAOSOPS_PATH)/board/chaosops/linux.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Rootfs (ext4) + ChaosOps branding overlay
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_CHAOSOPS_PATH)/board/chaosops/rootfs-overlay"
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="700M"

# GRUB2 (x86_64 EFI)
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y

# Bootable disk image via genimage (ESP + ext4 root)
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_CHAOSOPS_PATH)/board/chaosops/post-image.sh"
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y

# Handy base userland (milestone 1)
BR2_PACKAGE_UTIL_LINUX=y
BR2_SYSTEM_BIN_SH_BASH=y
BR2_PACKAGE_BASH=y
BR2_TARGET_GENERIC_HOSTNAME="chaosops"
BR2_TARGET_GENERIC_ISSUE="ChaosOps OS"

# Faster incremental rebuilds in CI
BR2_CCACHE=y
