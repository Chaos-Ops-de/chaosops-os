BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# x86-64 GPU coverage for ThinkCentre/NUC/generic Intel+AMD (Mesa gallium +
# vulkan). IRIS = modern Intel (Gen8+), CROCUS/I915 = older Intel, RADEONSI/
# R600 = AMD. SWRAST fallback comes from the shared chaosops.frag.
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_CROCUS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_I915=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_RADEONSI=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_R600=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_INTEL=y

# Broad x86_64 arch-default kernel (maximum driver coverage) + ChaosOps fragment
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.58"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CHAOSOPS_PATH)/board/x86_64/linux.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# ext4 rootfs
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="700M"

# GRUB2 x86_64 EFI + bootable disk image (ESP + root) via genimage
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_CHAOSOPS_PATH)/board/x86_64/post-image.sh"
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y

# Legacy-BIOS (SeaBIOS) / v86-compatible hybrid ISO, built alongside the
# UEFI disk image above. ISOLINUX gives a real El-Torito BIOS boot sector +
# boot catalog (xorriso -b isolinux/isolinux.bin -no-emul-boot
# -boot-load-size 4 -boot-info-table, handled by Buildroot's fs/iso9660);
# HYBRID runs isohybrid over the finished ISO so it also `dd`s straight to a
# USB stick. The whole rootfs is packed uncompressed as the ISO's initrd
# (default cpio compression = none) to keep it small enough to load in one
# shot even in memory-limited emulators/VMs. NOTE: v86 only emulates 32-bit
# protected mode, not x86_64 long mode, so this x86_64 kernel will not boot
# there - see chaosops_i686_defconfig for the browser/v86-compatible build.
BR2_TARGET_SYSLINUX=y
BR2_TARGET_SYSLINUX_ISOLINUX=y
BR2_TARGET_ROOTFS_ISO9660=y
BR2_TARGET_ROOTFS_ISO9660_ISOLINUX=y
BR2_TARGET_ROOTFS_ISO9660_BOOT_MENU="$(BR2_EXTERNAL_CHAOSOPS_PATH)/board/x86_64/isolinux.cfg"
BR2_TARGET_ROOTFS_ISO9660_INITRD=y
BR2_TARGET_ROOTFS_ISO9660_HYBRID=y
