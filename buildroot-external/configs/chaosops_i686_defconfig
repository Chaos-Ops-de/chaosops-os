# ChaosOps OS - 32-bit i686 Legacy-BIOS / browser-emulator (v86) build.
# v86 (https://copy.sh/v86) only emulates 32-bit x86 protected mode, not
# x86_64 long mode, so the amd64/x86_64 image (chaosops_x86_64_defconfig)
# can't boot there. This target produces an ISO-only, ISOLINUX/El-Torito
# hybrid image (same fs/iso9660 pipeline as x86_64) built for i386 instead,
# so it also runs under SeaBIOS in v86 and on real 32-bit-only Legacy-BIOS
# hardware. No genimage/EFI/disk-image output here - the whole rootfs
# travels as the ISO's initrd, so there's no root filesystem to mount and
# no disk controller driver dependency at boot.
BR2_i386=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.58"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CHAOSOPS_PATH)/board/i686/linux.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Legacy-BIOS (SeaBIOS) / v86 hybrid ISO: ISOLINUX gives a real El-Torito
# BIOS boot sector + boot catalog (xorriso -b isolinux/isolinux.bin
# -no-emul-boot -boot-load-size 4 -boot-info-table); HYBRID runs isohybrid
# over the finished ISO so it also `dd`s straight to a USB stick. The
# rootfs is packed uncompressed as the initrd (default cpio compression =
# none) to keep it small enough to load in one shot in memory-limited
# emulators/VMs.
BR2_TARGET_SYSLINUX=y
BR2_TARGET_SYSLINUX_ISOLINUX=y
BR2_TARGET_ROOTFS_ISO9660=y
BR2_TARGET_ROOTFS_ISO9660_ISOLINUX=y
BR2_TARGET_ROOTFS_ISO9660_BOOT_MENU="$(BR2_EXTERNAL_CHAOSOPS_PATH)/board/i686/isolinux.cfg"
BR2_TARGET_ROOTFS_ISO9660_INITRD=y
BR2_TARGET_ROOTFS_ISO9660_HYBRID=y
