#!/bin/sh
# ChaosOps kiosk session launcher (run by chaosops-kiosk.service on tty1).
#
# Stage 2A-2 (this): cog (WPE WebKit) fullscreen on the DRM platform — straight
# on KMS with no compositor — showing the branded boot-test page. This proves
# the browser renders HTML/CSS/JS on real hardware. Later stages point cog at
# the local kiosk-shell on http://127.0.0.1:8080/.
#
# kmscube is still installed as a fallback graphics debug tool (run it by hand).
set -eu

URL="file:///usr/share/chaosops/boot-test.html"

exec env COG_PLATFORM=drm cog --platform=drm "$URL"
