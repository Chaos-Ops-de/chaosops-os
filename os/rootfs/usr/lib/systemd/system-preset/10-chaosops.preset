# systemd re-applies presets on first boot (machine-id is "uninitialized" in
# the image). Keep that consistent with customize.sh: Arch's defaults would
# otherwise try to (re-)enable gettys, which are masked on the kiosk.
enable NetworkManager.service
enable systemd-timesyncd.service
enable wifi-agent.service
enable chaosops-hotkeyd.service
enable chaosops-kiosk.service
enable chaosops-growroot.service
disable getty@.service
disable serial-getty@.service
disable console-getty.service
disable autovt@.service
disable sshd.service
disable systemd-networkd.service
disable systemd-resolved.service
