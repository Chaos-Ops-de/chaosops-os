[Unit]
Description=ChaosOps kiosk session (cage + Chromium on tty1)
Wants=wifi-agent.service
After=wifi-agent.service systemd-user-sessions.service
# Take the screen over from Plymouth ourselves, like a display manager: the
# stock plymouth-quit would drop to a bare console before cage is up. If the
# kiosk can't start at all, still let Plymouth go.
Conflicts=plymouth-quit.service
After=plymouth-quit.service
OnFailure=plymouth-quit.service
# Own tty1 outright — no getty may ever appear there.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=kiosk
Group=kiosk
SupplementaryGroups=video render input
# PAM session on the TTY (os/rootfs/etc/pam.d/chaosops-kiosk) registers a
# logind seat session, which cage needs to open DRM/input without root.
PAMName=chaosops-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=XDG_SESSION_TYPE=wayland
# Chromium profile lives here (owned by the kiosk user, survives reboots so a
# paired display stays paired). The reset chord clears it via the shell.
StateDirectory=chaosops-kiosk
# The splash keeps animating while we wait for wifi-agent to answer, then
# freezes its last frame on screen (--retain-splash) until cage modesets.
# "-": no Plymouth on a restart is fine; "+": plymouthd only listens to root.
ExecStartPre=/usr/local/bin/chaosops-kiosk --wait-for-agent
ExecStartPre=-+/usr/bin/plymouth quit --retain-splash
ExecStart=/usr/local/bin/chaosops-kiosk
Restart=always
RestartSec=2

# NB: keep sandboxing light here — this is a PAM/TTY graphical session; the
# real confinement is the unprivileged user + cage + Chromium policy.
# (No ProtectHome=: it also hides /run/user, where cage's Wayland socket lives.)
NoNewPrivileges=yes

[Install]
WantedBy=graphical.target
